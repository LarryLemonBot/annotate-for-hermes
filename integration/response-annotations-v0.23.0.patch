+    const recipient = { onTranscript: vi.fn(), onState: vi.fn() }
+
+    const hook = renderHook(
+      ({ sessionId }) => usePluginDictation({ target: 'main', sessionId, disabled: false, recorder }),
+      { initialProps: { sessionId: 'a' } }
+    )
