diff --git a/apps/desktop/src/lib/response-annotations.test.ts b/apps/desktop/src/lib/response-annotations.test.ts
new file mode 100644
index 0000000000..996781e33a
--- /dev/null
+++ b/apps/desktop/src/lib/response-annotations.test.ts
@@ -0,0 +1,69 @@
+import { describe, expect, it } from 'vitest'
+
+import { composerPlainText, refChipHtml } from '@/app/chat/composer/rich-editor'
+import { referenceRe } from '@/components/assistant-ui/reference-kinds'
+
+import { captureResponseSelection, formatResponseAnnotations, parseResponseAnnotations } from './response-annotations'
+
+describe('response annotation references', () => {
+  it('does not offer response annotations for selected user text or the main draft', () => {
+    for (const markup of ['<p>A user message</p>', '<div contenteditable="true">An ordinary reply</div>']) {
+      const root = document.createElement('div')
+      root.innerHTML = markup
+      document.body.append(root)
+      const range = document.createRange()
+      range.selectNodeContents(root.firstElementChild!)
+      window.getSelection()!.removeAllRanges()
+      window.getSelection()!.addRange(range)
+      expect(captureResponseSelection()).toBeNull()
+      root.remove()
+    }
+
+    window.getSelection()!.removeAllRanges()
+  })
+  it('keeps three pairs in one native chip and round-trips every character', () => {
+    const data = {
+      type: 'response-annotations' as const,
+      version: 1 as const,
+      label: '3 annotations',
+      annotations: [
+        { id: '1', text: 'First passage', comment: 'First comment' },
+        { id: '2', text: '```js\n  call(`x`);\n```', comment: 'two\nlines' },
+        { id: '3', text: '@file:/private/example <script> /command', comment: 'Keep this literal' }
+      ]
+    }
+
+    const token = formatResponseAnnotations(data)
+    const matches = [...token.matchAll(referenceRe())]
+    expect(matches).toHaveLength(1)
+    expect(matches[0]![1]).toBe('annotation')
+    const raw = matches[0]![2]!
+    expect(parseResponseAnnotations(raw.slice(1, -1))).toEqual(data)
+    const editor = document.createElement('div')
+    editor.innerHTML = 'Existing reply ' + refChipHtml('annotation', raw)
+    expect(editor.textContent).toBe('Existing reply 3 annotations')
+    expect(composerPlainText(editor).trimEnd()).toBe('Existing reply ' + token)
+  })
+
+  it('refuses invalid, duplicate or oversized entries rather than hiding data', () => {
+    for (const value of [
+      '{}',
+      'not json',
+      JSON.stringify({ type: 'response-annotations', version: 1, label: '1', annotations: [] })
+    ]) {
+      expect(parseResponseAnnotations(value)).toBeNull()
+    }
+
+    expect(() =>
+      formatResponseAnnotations({
+        type: 'response-annotations',
+        version: 1,
+        label: '2 annotations',
+        annotations: [
+          { id: 'same', text: 'one', comment: '' },
+          { id: 'same', text: 'two', comment: '' }
+        ]
+      })
+    ).toThrow()
+  })
+})
diff --git a/apps/desktop/src/lib/response-annotations.ts b/apps/desktop/src/lib/response-annotations.ts
new file mode 100644
index 0000000000..92bf45f544
--- /dev/null
+++ b/apps/desktop/src/lib/response-annotations.ts
@@ -0,0 +1,116 @@
+/** Self-contained response references: the draft, queue and saved message all
+ * carry the same data. No local-storage lookup is required to recover a reply. */
+export interface ResponseAnnotation {
+  id: string
+  text: string
+  comment: string
+}
+
+export interface ResponseAnnotations {
+  type: 'response-annotations'
+  version: 1
+  label: string
+  annotations: ResponseAnnotation[]
+}
+
+export interface ResponseAnnotationOpen {
+  value: string
+  editable: boolean
+  remove?: boolean
+  anchor?: { left: number; top: number; bottom: number; width: number }
+}
+
+const OPEN_EVENT = 'hermes:response-annotations-open'
+const MAX_WIRE_CHARS = 512_000
+
+/** Capture at the native boundary so plugins never depend on transcript markup. */
+export function captureResponseSelection(): { text: string; range: Range; anchor: DOMRect } | null {
+  const selection = window.getSelection()
+
+  if (!selection?.rangeCount || selection.isCollapsed) {return null}
+  const range = selection.getRangeAt(0).cloneRange()
+  const ancestor = range.commonAncestorContainer
+  const element = ancestor instanceof Element ? ancestor : ancestor.parentElement
+  const response = element?.closest('[data-slot="aui_assistant-message-root"]')
+
+  if (!response || !response.contains(range.startContainer) || !response.contains(range.endContainer)) {return null}
+
+  if (element?.closest('input, textarea, [contenteditable="true"]')) {return null}
+  const text = selection.toString()
+
+  if (!text.trim() || text.length > 64_000) {return null}
+
+  return { text, range, anchor: range.getBoundingClientRect() }
+}
+
+export function parseResponseAnnotations(value: string): ResponseAnnotations | null {
+  if (value.length > MAX_WIRE_CHARS) {
+    return null
+  }
+
+  try {
+    const data = JSON.parse(value) as ResponseAnnotations
+
+    if (
+      data?.type !== 'response-annotations' ||
+      data.version !== 1 ||
+      typeof data.label !== 'string' ||
+      data.label.length > 80 ||
+      !Array.isArray(data.annotations) ||
+      !data.annotations.length ||
+      data.annotations.length > 100
+    ) {
+      return null
+    }
+
+    const ids = new Set<string>()
+
+    for (const item of data.annotations) {
+      if (
+        !item ||
+        typeof item.id !== 'string' ||
+        !item.id ||
+        ids.has(item.id) ||
+        typeof item.text !== 'string' ||
+        !item.text ||
+        item.text.length > 64_000 ||
+        typeof item.comment !== 'string' ||
+        item.comment.length > 64_000
+      ) {
+        return null
+      }
+
+      ids.add(item.id)
+    }
+
+    return data
+  } catch {
+    return null
+  }
+}
+
+export function formatResponseAnnotations(data: ResponseAnnotations): string {
+  const value = JSON.stringify(data)
+    // Keep a single reference token and prevent selected @file:/slash content
+    // from becoming a second executable reference in another surface.
+    .replace(/[`@<>/]/g, char => `\\u${char.charCodeAt(0).toString(16).padStart(4, '0')}`)
+
+  if (!parseResponseAnnotations(value)) {
+    throw new Error('Invalid response annotations')
+  }
+
+  return `@annotation:\`${value}\``
+}
+
+export function openResponseAnnotations(request: ResponseAnnotationOpen): void {
+  if (parseResponseAnnotations(request.value)) {
+    window.dispatchEvent(new CustomEvent(OPEN_EVENT, { detail: request }))
+  }
+}
+
+export function onResponseAnnotationsOpen(listener: (request: ResponseAnnotationOpen) => void): () => void {
+  const receive = (event: Event) => listener((event as CustomEvent<ResponseAnnotationOpen>).detail)
+  window.addEventListener(OPEN_EVENT, receive)
+
+  return () => window.removeEventListener(OPEN_EVENT, receive)
+}
